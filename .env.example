# Server-only PostgreSQL URL. Required for runtime queries, not for next build.
# This localhost URL is for local development only; use a hosted DB URL on Vercel.
# Vercel: Project > Settings > Environment Variables > DATABASE_URL.
# Configure Production, Preview, and Development, then redeploy.
# Use separate databases per environment. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Staff dashboard authentication. Use a unique password and a random secret of 32+ characters.
ADMIN_PASSWORD=replace-with-a-strong-staff-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Used for starter-shop provisioning and absolute QR destinations
DEFAULT_SHOP_NAME=Sunbeam Print Co.
DEFAULT_SHOP_SLUG=sunbeam-print
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required to authorize the scheduled retention endpoint
CRON_SECRET=replace-with-a-separate-random-cron-secret

# Local private storage is used when S3_BUCKET is not set.
# For production/serverless deployments, configure a private S3-compatible bucket instead.
# PRINTDROP_STORAGE_DIR=/var/lib/printdrop/uploads
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
